applications:
  root:
    namespace: argocd
    project: default
    source:
      repoURL: ${repo_url}
      targetRevision: ${target_revision}
      path: gitops/apps
    destination:
      server: https://kubernetes.default.svc
      namespace: argocd
    syncPolicy:
      automated:
        prune: true      # ลบไฟล์ใน Git → ลบของใน cluster
        selfHeal: true   # มีคนแก้ด้วย kubectl → Argo แก้กลับให้ตรงกับ Git
